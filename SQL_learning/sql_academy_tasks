-- Задача № 1
-- Вывести имена всех людей, которые есть в базе данных авиакомпаний.
-- Поля в результирующей таблице: name
SELECT name
FROM passenger;

-- Задача № 3
-- Вывести все рейсы, совершенные из Москвы.
-- Поля в результирующей таблице: *
SELECT *
FROM trip
WHERE town_from = 'moscow';

-- Задача № 4
-- Вывести имена людей, которые заканчиваются на "man".
-- Поля в результирующей таблице: name
SELECT name
FROM Passenger
WHERE name LIKE '%man';

-- Задача № 139
-- Страна считается большой, если:
-- её площадь составляет не менее 3 миллионов км² (3000000), или
-- её население составляет не менее 25 миллионов человек (25000000).
-- Напишите запрос для поиска названия (name), населения (population) и площади (area) больших стран.
-- Поля в результирующей таблице: name population area
SELECT name, population, area
FROM World
WHERE (area >= 3000000 OR population >= 25000000)
ORDER BY area DESC;

-- Задача № 168
-- В таблице bets поле betting_type принимает значения sports, casino, poker, esports.
-- Напишите запрос, который вернёт betting_type и avg_amount — средний размер ставки, округлённый до двух знаков. Отсортируйте по avg_amount по возрастанию.
-- Поля в результирующей таблице: betting_type avg_amount
SELECT betting_type, ROUND(AVG(bet_amount),2) AS avg_amount
FROM bets
GROUP BY betting_type
ORDER BY avg_amount;
